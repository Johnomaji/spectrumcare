# The live origin. Used for page metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://spectrumcare.com.ng

# --- Forms: pick ONE of the two, depending on how the site is hosted. ---

# A) Hosting with Node (Vercel, VPS, cPanel Node app).
# Submissions go to this site's own /api/forms route, which validates them and
# forwards them here. This URL stays on the server and is never exposed.
# Any endpoint that accepts a JSON POST: a form service, an automation, or
# your own mailer. While it is empty, forms tell visitors to call instead.
FORM_WEBHOOK_URL=

# B) Static-only hosting (npm run build:static).
# There is no server, so the browser posts straight to a hosted form service
# such as Formspree or Web3Forms. This URL is visible in the page source, so
# use a provider whose endpoints are designed to be public.
# NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx
